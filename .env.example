# คัดลอกเป็น .env แล้วแก้ ห้าม commit ไฟล์ .env
DB_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาว ๆ
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
APP_URL=http://localhost:8080
# ใช้ HTTPS จริงให้ตั้งเป็น true
COOKIE_SECURE=false
# อีเมลแจ้งเตือน ปล่อยว่างไว้ = ไม่ส่งอีเมลจริง
SMTP_USER=you@gmail.com
SMTP_PASSWORD=รหัสผ่านแอปของ Gmail 16 ตัว
MAIL_FROM=you@gmail.com
# ปลายทางทดสอบการส่งอีเมลด้วยมือ ปล่อยว่างไว้ = ปิด
ADMIN_TOKEN=
